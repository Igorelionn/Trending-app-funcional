# ============================================================
# SUPABASE (obrigatório)
# ============================================================
VITE_SUPABASE_URL=https://SEU_PROJETO_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_AQUI

# ⚠️ SERVICE ROLE KEY — nunca exponha em repositório público.
# Necessária para operações de admin (upserts bypassing RLS).
VITE_SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# ============================================================
# SERVIDOR DE MÍDIA DEDICADO (MediaMTX — escala 10k viewers)
# Deixar vazio para usar LiveKit Cloud (modo desenvolvimento)
# Configurar quando tiver o servidor Hetzner rodando
# ============================================================
VITE_MEDIA_SERVER_URL=https://stream.seudominio.com.br
VITE_MEDIA_SERVER_KEY=

# ============================================================
# LIVEKIT (fallback quando MEDIA_SERVER_URL não estiver configurado)
# ============================================================
# Apenas a API key pode ser exposta no frontend (é pública)
VITE_LIVEKIT_API_KEY=SUA_LIVEKIT_API_KEY
VITE_LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud

# ⚠️ API SECRET — apenas no backend (Vercel serverless), NUNCA no frontend
LIVEKIT_API_KEY=SUA_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=SUA_LIVEKIT_API_SECRET
LIVEKIT_URL=wss://SEU_PROJETO.livekit.cloud

# ============================================================
# FINNHUB (notícias financeiras)
# ============================================================
# Usada no serverless — não precisa do prefixo VITE_
FINNHUB_API_KEY=SUA_CHAVE_FINNHUB

# ============================================================
# BINANCE (dados de mercado — opcional, API pública gratuita)
# ============================================================
VITE_BINANCE_API_KEY=
VITE_BINANCE_API_SECRET=

# ============================================================
# AMBIENTE
# ============================================================
NODE_ENV=development
VITE_APP_ENV=development

# ============================================================
# VERCEL CRON (segurança do endpoint /api/rotate-signals)
# ============================================================
CRON_SECRET=CRIE_UM_SEGREDO_ALEATORIO_AQUI
